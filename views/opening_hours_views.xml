<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Rozvrhy: výchozí a sezónní (na rozmezí dat)
         ============================================================ -->

    <record id="view_opening_hours_schedule_list" model="ir.ui.view">
        <field name="name">opening.hours.schedule.list</field>
        <field name="model">opening.hours.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="validity"/>
                <field name="period_display"/>
                <field name="is_default" column_invisible="True"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_opening_hours_schedule_form" model="ir.ui.view">
        <field name="name">opening.hours.schedule.form</field>
        <field name="model">opening.hours.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivováno" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="např. Zima"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="validity" widget="radio"/>
                            <field name="date_from" invisible="validity != 'dates'" required="validity == 'dates'"/>
                            <field name="date_to" invisible="validity != 'dates'" required="validity == 'dates'"/>
                            <field name="repeat_yearly" invisible="validity != 'dates'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="period_display"/>
                        </group>
                    </group>
                    <div class="text-muted mb-3">
                        Letní a zimní čas se přepínají samy s posunem hodin (poslední neděle v březnu
                        a v říjnu). Rozvrh na rozmezí dat (třeba Vánoce) má před nimi přednost, při
                        překryvu platí ten s kratším rozmezím. Výchozí rozvrh platí, když neplatí žádný
                        jiný. Výjimky na jednotlivé dny mají přednost před všemi rozvrhy.
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" default_order="day_of_week" create="0">
                            <field name="day_of_week"/>
                            <field name="is_open"/>
                            <field name="open_time" widget="float_time" invisible="not is_open"/>
                            <field name="close_time" widget="float_time" invisible="not is_open"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_opening_hours_schedule_search" model="ir.ui.view">
        <field name="name">opening.hours.schedule.search</field>
        <field name="model">opening.hours.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="inactive" string="Archivované" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_opening_hours_schedule" model="ir.actions.act_window">
        <field name="name">Rozvrhy otevírací doby</field>
        <field name="res_model">opening.hours.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'opening_hours_prefill': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Založte výchozí rozvrh (bez dat) a případně sezónní rozvrhy, třeba na zimu
            </p>
        </field>
    </record>

    <!-- ============================================================
         Opening Hours - Overrides (holidays, special days)
         ============================================================ -->

    <record id="view_opening_hours_override_tree" model="ir.ui.view">
        <field name="name">opening.hours.override.tree</field>
        <field name="model">opening.hours.override</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="date">
                <field name="date"/>
                <field name="is_open"/>
                <field name="open_time" widget="float_time" invisible="not is_open"/>
                <field name="close_time" widget="float_time" invisible="not is_open"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_opening_hours_override_calendar" model="ir.ui.view">
        <field name="name">opening.hours.override.calendar</field>
        <field name="model">opening.hours.override</field>
        <field name="arch" type="xml">
            <calendar date_start="date" date_stop="date" color="is_open" mode="month" quick_create="0">
                <field name="reason"/>
                <field name="is_open"/>
            </calendar>
        </field>
    </record>

    <record id="view_opening_hours_override_form" model="ir.ui.view">
        <field name="name">opening.hours.override.form</field>
        <field name="model">opening.hours.override</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="is_open"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="open_time" widget="float_time" invisible="not is_open"/>
                            <field name="close_time" widget="float_time" invisible="not is_open"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_opening_hours_override" model="ir.actions.act_window">
        <field name="name">Výjimky otevírací doby</field>
        <field name="res_model">opening.hours.override</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Přidejte výjimky pro svátky a speciální dny
            </p>
        </field>
    </record>

    <!-- ============================================================
         Stav obchůdku: teď otevřeno/zavřeno, ruční otevření a zavření, Home Assistant
         ============================================================ -->

    <record id="view_opening_hours_status_form" model="ir.ui.view">
        <field name="name">opening.hours.status.form</field>
        <field name="model">opening.hours.status</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0" string="Stav obchůdku">
                <header>
                    <button name="action_open" type="object" string="Otevřít" class="btn-primary"
                            invisible="is_open_now"/>
                    <button name="action_close" type="object" string="Zavřít" class="btn-primary"
                            invisible="not is_open_now"/>
                    <button name="action_close" type="object" string="Dnes už neotevírat"
                            invisible="is_open_now or manual_active or not opens_later_today"/>
                    <button name="action_follow_schedule" type="object" string="Zpět podle rozvrhu"
                            invisible="not manual_active"/>
                </header>
                <sheet>
                    <field name="is_open_now" invisible="1"/>
                    <field name="manual_active" invisible="1"/>
                    <field name="opens_later_today" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="state_label" widget="badge"
                                   decoration-success="is_open_now" decoration-danger="not is_open_now"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Teď">
                            <field name="state_detail"/>
                            <field name="today_hours"/>
                            <field name="next_change_display"/>
                        </group>
                        <group string="Home Assistant">
                            <field name="ha_is_open"/>
                            <field name="last_update"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Otevřít / Zavřít</strong> platí do nejbližší změny podle rozvrhu,
                        nejdéle do konce dne. Otevřít v 10:00 při otevírací době 15–19 = otevřeno
                        nepřetržitě do 19:00. <strong>Dnes už neotevírat</strong> = zavřeno i
                        v dnešní otevírací době. Otevírací dobu mění správce v Rozvrzích a Výjimkách.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_opening_hours_status" model="ir.actions.act_window">
        <field name="name">Stav obchůdku</field>
        <field name="res_model">opening.hours.status</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_opening_hours_status_form"/>
        <field name="res_id" ref="opening_hours_status_default"/>
        <field name="target">current</field>
    </record>

</odoo>
