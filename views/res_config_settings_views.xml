<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nastavení → Web: napojení Home Assistantu na otevírací dobu (pro správce, ne obsluhu) -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website_opening_hours</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Otevírací doba – Home Assistant" id="website_opening_hours_settings">
                    <setting id="opening_hours_webhook_setting"
                             string="Webhook Secret"
                             help="Tajný klíč, který Home Assistant posílá s hlášením o otevření a zavření obchůdku (stejný jako ve vstupu blueprintu). Prázdný = webhook přijme cokoli.">
                        <field name="opening_hours_webhook_secret" password="True"/>
                        <div class="text-muted small mt-2">
                            Otevírací dobu řídí Odoo. Home Assistant se každou minutu ptá na
                            <code>/opening-hours/ha-state</code> (JSON-RPC) a podle odpovědi přepíná
                            <code>input_boolean.obchudek_otevren</code>. Ruční přepnutí v HA posílá na
                            <code>/opening-hours/webhook</code>
                            (<code>{"secret", "is_open", "changed_at"}</code>) a Odoo ho bere jako
                            ruční otevření/zavření. Blueprinty jsou v repu <code>ha_config</code>:
                            <code>odoo_opening_hours_follow.yaml</code> a <code>odoo_opening_hours.yaml</code>.
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
